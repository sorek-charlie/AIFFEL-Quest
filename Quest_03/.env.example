# 설계용 예시. 현재 실행 가능한 API는 아직 없습니다.
# 실제 .env는 Git에 넣지 않습니다. 아래 빈 값은 구현 시 환경별로 채웁니다.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3001
DEFAULT_TIME_ZONE=Asia/Seoul
DATABASE_PROVIDER=sqlite
SQLITE_PATH=./runtime/data/todo.db
AUTH_PROVIDER=local-dev
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_SECRET_KEY=
SESSION_SECRET=
# 공개 기능·외부 발송은 기본 비활성
PUBLIC_BOOKING_ENABLED=false
NOTIFICATION_PROVIDER=disabled
CALENDAR_SYNC_PROVIDER=disabled
